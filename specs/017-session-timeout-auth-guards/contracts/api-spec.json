{
  "openapi": "3.0.0",
  "info": {
    "title": "Admin Authentication & Protected Endpoints API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "summary": "Authenticate admin user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string" },
                  "pin": { "type": "string" }
                },
                "required": ["username", "pin"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful, returns token" },
          "401": { "description": "Invalid username or PIN" }
        }
      }
    },
    "/api/auth/verify": {
      "get": {
        "summary": "Verify active admin session",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Session is active and valid" },
          "401": { "description": "Session expired or invalid" }
        }
      }
    },
    "/api/admin/{endpoint}": {
      "get": {
        "summary": "Any admin endpoint",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Admin data returned" },
          "401": { "description": "Unauthorized: Session expired or invalid" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
