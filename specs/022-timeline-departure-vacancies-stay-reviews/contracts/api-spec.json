{
  "openapi": "3.0.0",
  "info": {
    "title": "Stay Review Update Endpoint",
    "version": "1.0.0"
  },
  "paths": {
    "/api/admin/volunteers/{id}/stays/{stayId}": {
      "put": {
        "summary": "Update review rating, notes, and rehire status of a past stay",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "stayId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "departureRating": { "type": "integer", "minimum": 1, "maximum": 5 },
                  "departureNotes": { "type": "string" },
                  "rehireStatus": { "type": "string", "enum": ["Accept", "Conditional", "Do Not Accept"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Stay review updated successfully" },
          "400": { "description": "Invalid input data" }
        }
      }
    }
  }
}
